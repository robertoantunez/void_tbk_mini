#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    trackball_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&vtrackball>;
        layers = <0 2 3 4 5>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <4>;
        bindings = <&ib_toggle_layer 5>;
    };

    trackball_snipe_listener {
        compatible = "zmk,input-behavior-listener";   
        device = <&vtrackball>;
        layers = <>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <12>;
    };

    trackball_scroll_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&vtrackball>;
        layers = <1>;
        evt-type = <INPUT_EV_REL>;            
        x-input-code = <INPUT_REL_MISC>;
        y-input-code = <INPUT_REL_WHEEL>;
        y-invert;
        bindings = <&ib_wheel_scaler 1 16>;
    };

    ib_wheel_scaler: ib_wheel_scaler {
        compatible = "zmk,input-behavior-scaler";
        #binding-cells = <2>;
        evt-type = <INPUT_EV_REL>;
        input-code = <INPUT_REL_WHEEL>;
    };

    ib_toggle_layer: ib_toggle_layer {
        compatible = "zmk,input-behavior-tog-layer";
        #binding-cells = <1>;
        time-to-live-ms = <750>;
    };

    behaviors {
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <240>;
            quick-tap-ms = <150>;
            bindings = 
                <&mo>,
                <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";
            bindings = <
&kp TAB           &kp Q  &kp W  &kp E             &kp R      &kp T    &kp Y  &kp U          &kp I          &kp O    &kp P     &kp ENTER
&kp LEFT_SHIFT    &kp A  &kp S  &kp D             &kp F      &kp G    &kp H  &kp J          &kp K          &kp L    &kp SEMI  &kp APOS
&kp LEFT_CONTROL  &kp Z  &kp X  &kp C             &kp V      &kp B    &kp N  &kp M          &kp COMMA      &kp DOT  &kp FSLH  &kp RSHIFT
                                &kp LEFT_COMMAND  &kp SPACE  &mo 1    &mo 2  &kp BACKSPACE  &kp RIGHT_ALT
            >;
        };

        Lower {
            label = "Lower";
            bindings = <
&kp TAB  &kp F2          &none           &trans          &trans                &trans                   &kp ASTRK  &kp N7     &kp N8         &kp N9  &kp MINUS   &kp DELETE
&trans   &kp F7          &none           &kp UP_ARROW    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &kp SLASH  &kp N4     &kp N5         &kp N6  &kp PLUS    &kp HOME
&trans   &kp KP_NUMLOCK  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW       &kp EQUAL                &kp N0     &kp N1     &kp N2         &kp N3  &kp PERIOD  &kp END
                                         &kp LGUI        &kp SPACE             &trans                   &mo 3      &kp ENTER  &kp RIGHT_ALT
            >;
        };

        Raise {
            label = "Raise";
            bindings = <
&kp ESC         &kp EXCL      &kp AT           &kp HASH          &kp DLLR              &kp PRCNT                &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp BACKSPACE
&kp CAPSLOCK    &none         &kp ASTRK        &kp SLASH         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &kp EQUAL  &kp UNDER  &kp LBKT         &kp RBKT  &kp BSLH  &kp GRAVE
&kp LEFT_SHIFT  &kp C_VOL_DN  &kp C_VOLUME_UP  &kp C_PLAY_PAUSE  &kp C_PREV            &kp C_NEXT               &kp PLUS   &kp MINUS  &kp LBRC         &kp RBRC  &kp PIPE  &kp TILDE
                                               &kp LGUI          &kp SPACE             &mo 3                    &trans     &trans     &trans
            >;
        };

        Game {
            label = "Game";
            bindings = <
&rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &rgb_ug RGB_TOG    &trans  &trans  &trans  &trans  &trans  &trans
&rgb_ug RGB_EFR  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &trans             &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR       &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &trans           &trans             &trans  &kp F1  &trans  &trans  &trans  &to 0
                                                   &trans           &trans           &none              &none   &trans  &trans
            >;
        };
    };
};


